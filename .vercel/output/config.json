{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/about/?(?:/__data.json)?$",
			"dest": "/about"
		},
		{
			"src": "^/admin/?(?:/__data.json)?$",
			"dest": "/admin"
		},
		{
			"src": "^/admin/accounts/?(?:/__data.json)?$",
			"dest": "/admin/accounts"
		},
		{
			"src": "^/admin/products/?(?:/__data.json)?$",
			"dest": "/admin/products"
		},
		{
			"src": "^/admin/products/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/admin/products/[id]"
		},
		{
			"src": "^/api/cashier/update-status/?(?:/__data.json)?$",
			"dest": "/api/cashier/update-status"
		},
		{
			"src": "^/api/checkout/?(?:/__data.json)?$",
			"dest": "/api/checkout"
		},
		{
			"src": "^/api/checkout/cancel/?(?:/__data.json)?$",
			"dest": "/api/checkout/cancel"
		},
		{
			"src": "^/api/checkout/confirm/?(?:/__data.json)?$",
			"dest": "/api/checkout/confirm"
		},
		{
			"src": "^/api/checkout/retry/?(?:/__data.json)?$",
			"dest": "/api/checkout/retry"
		},
		{
			"src": "^/api/midtrans-webhook/?(?:/__data.json)?$",
			"dest": "/api/midtrans-webhook"
		},
		{
			"src": "^/api/upload/?(?:/__data.json)?$",
			"dest": "/api/upload"
		},
		{
			"src": "^/auth/callback/?(?:/__data.json)?$",
			"dest": "/auth/callback"
		},
		{
			"src": "^/auth/login/?(?:/__data.json)?$",
			"dest": "/auth/login"
		},
		{
			"src": "^/auth/register/?(?:/__data.json)?$",
			"dest": "/auth/register"
		},
		{
			"src": "^/cart/?(?:/__data.json)?$",
			"dest": "/cart"
		},
		{
			"src": "^/cashier/?(?:/__data.json)?$",
			"dest": "/cashier"
		},
		{
			"src": "^/cashier/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/cashier/[id]"
		},
		{
			"src": "^/checkout/?(?:/__data.json)?$",
			"dest": "/checkout"
		},
		{
			"src": "^/menu/?(?:/__data.json)?$",
			"dest": "/menu"
		},
		{
			"src": "^/menu/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/menu/[id]"
		},
		{
			"src": "^/profile/?(?:/__data.json)?$",
			"dest": "/profile"
		},
		{
			"src": "^/profile/orders/?(?:/__data.json)?$",
			"dest": "/profile/orders"
		},
		{
			"src": "^/profile/orders/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/profile/orders/[id]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}